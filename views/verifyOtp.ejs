<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    * { font-family: 'Inter', sans-serif; }
  </style>
</head>

<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-4">

  <div class="bg-white shadow-2xl rounded-2xl w-full max-w-md p-8 border border-gray-100">

    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-full mb-4 shadow-lg">
        <span class="text-3xl">🔐</span>
      </div>
      <h2 class="text-3xl font-bold text-gray-800 mb-2">
        OTP Verification
      </h2>
      <div class="w-16 h-1 bg-gradient-to-r from-blue-500 to-indigo-500 mx-auto rounded-full mb-4"></div>
    </div>

    <p class="text-sm text-gray-600 text-center mb-8 bg-gray-50 p-4 rounded-lg border border-gray-200">
      We've sent a 6-digit OTP to <br>
      <span class="font-semibold text-gray-800 text-base block mt-2">
        <%= email %>
      </span>
    </p>

    <% if (error) { %>
      <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-lg">
        <div class="flex items-center">
          <span class="text-red-600 text-sm font-medium">
            <%= error %>
          </span>
        </div>
      </div>
      <% } %>

        <form method="POST" action="/verify-otp" class="space-y-6">

          <input type="hidden" name="email" value="<%= email %>" />

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3 text-center">
              Enter OTP Code
            </label>
            <input type="text" name="otp" maxlength="6" required
              class="w-full px-4 py-4 border-2 border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-center tracking-[0.5em] text-2xl font-bold transition-all duration-200"
              placeholder="000000" 
              pattern="[0-9]{6}"
              inputmode="numeric" />
            <p class="text-xs text-gray-500 text-center mt-2">Enter the 6-digit code sent to your email</p>
          </div>

          <button type="submit"
            class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold py-3 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5">
            Verify OTP
          </button>
        </form>

        <div class="text-center mt-8 pt-6 border-t border-gray-200">
          <p class="text-sm text-gray-600 mb-2">
            Didn't receive OTP?
          </p>
          <a href="/resendOtp/?email=<%=email%>"
            class="inline-block text-sm text-blue-600 hover:text-blue-700 font-semibold hover:underline transition-colors duration-200">
            Resend OTP Code
          </a>
        </div>

  </div>

</body>
</html>