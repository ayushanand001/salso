<%- include("partials/header") %>

    <div class="space-y-8 pb-12">
        <div class="text-center mb-10">
            <h2 class="text-3xl font-extrabold tracking-tighter text-[#0F172A] mb-2">
                Order Summary
            </h2>
            <p class="text-slate-400 text-xs font-bold uppercase tracking-widest">
                SALSO Premium
            </p>
        </div>

        <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-xl">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <p class="text-sm text-slate-400 font-bold uppercase tracking-widest mb-2">Booking for</p>
                    <h3 class="text-3xl font-extrabold tracking-tighter text-[#0F172A]">
                        <%= salon_name %>
                    </h3>
                </div>
                <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-scissors text-2xl text-[#E2B171]"></i>
                </div>
            </div>

            <div class="py-6 border-t border-slate-100">
                <p class="text-sm text-slate-400 font-bold uppercase tracking-widest mb-4">Selected Services</p>
                <div class="space-y-3">
                    <% features_price.forEach(item=> { %>
                        <div class="flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <span
                                    class="w-6 h-6 bg-[#E2B171]/10 text-[#E2B171] text-[10px] font-black rounded-md flex items-center justify-center">
                                    <%= item.quantity %>x
                                </span>
                                <span class="text-sm font-bold text-slate-700">
                                    <%= item.feature %>
                                </span>
                            </div>
                            <span class="text-sm font-extrabold text-[#0F172A]">₹<%= item.price %></span>
                        </div>
                        <% }) %>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">Scheduled Day</span>
                    <span class="font-extrabold text-[#0F172A]">
                        <%= dayslot %>
                    </span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">Time Slot</span>
                    <span class="font-extrabold text-[#0F172A]">
                        <%= timeslot %>
                    </span>
                </div>

                <div class="pt-4 border-t border-dashed border-slate-200 space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">Subtotal</span>
                        <span class="font-extrabold text-[#0F172A]">₹<%= subtotal %></span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">Service Fee</span>
                        <span class="font-extrabold text-[#0F172A]">₹<%= grandtotal - subtotal %></span>
                    </div>
                    <div class="flex items-center justify-between pt-4">
                        <span class="text-sm font-bold text-[#0F172A] uppercase tracking-widest">Grand Total</span>
                        <span class="text-3xl font-black text-[#E2B171]">₹<%= grandtotal %></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">

            <form action="/pay" method="POST"
                class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all">

                <input type="hidden" name="salon_id" value="<%= salon_id %>">
                <input type="hidden" name="grandtotal" value="<%= grandtotal %>">
                <input type="hidden" name="amount" value="<%= grandtotal %>">

                <input type="hidden" name="dayslot" value="<%= dayslot %>">
                <input type="hidden" name="timeslot" value="<%= timeslot %>">

                <% if (typeof user !=='undefined' && user && (user.name || user.email)) { %>
                    <input type="hidden" name="firstname" value="<%= user.name || '' %>">
                    <input type="hidden" name="email" value="<%= user.email || '' %>">
                    <% } else { %>
                        <div class="mb-3">
                            <label class="block text-sm text-slate-500">Full name</label>
                            <input name="firstname" required class="w-full mt-2 p-3 border border-slate-100 rounded-lg"
                                placeholder="Your name">
                        </div>
                        <div class="mb-3">
                            <label class="block text-sm text-slate-500">Email</label>
                            <input name="email" type="email" required
                                class="w-full mt-2 p-3 border border-slate-100 rounded-lg"
                                placeholder="you@example.com">
                        </div>
                        <% } %>

                            <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-4">
                                <i class="fa-solid fa-credit-card text-xl text-[#E2B171]"></i>
                            </div>

                            <h4 class="font-extrabold text-[#0F172A] mb-2">
                                Proceed to Payment
                            </h4>
                            <p class="text-sm text-slate-400 font-medium mb-4">
                                Complete your booking securely
                            </p>

                            <button type="submit"
                                class="w-full bg-[#0F172A] text-white font-extrabold py-4 px-6 rounded-2xl hover:bg-[#E2B171] transition-all uppercase text-xs tracking-widest">
                                Pay Now
                            </button>
            </form>

            <a href="/salons/<%= salon_id %>"
                class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all block">
                <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-4">
                    <i class="fa-solid fa-arrow-left text-xl text-[#E2B171]"></i>
                </div>
                <h4 class="font-extrabold text-[#0F172A] mb-2">
                    Modify Booking
                </h4>
                <p class="text-sm text-slate-400 font-medium">
                    Go back to salon page
                </p>
            </a>

        </div>
    </div>

    <%- include("partials/footer") %>