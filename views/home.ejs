<%- include("partials/header") %>

<div class="text-center space-y-6">
  <div class="space-y-3">
    <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
      Welcome to Authentication System
    </h1>
    <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-indigo-500 mx-auto rounded-full"></div>
  </div>

  <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto">
    This project demonstrates authentication and authorization using EJS & Tailwind CSS.
  </p>

  <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8">
    <a href="/login" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 transform hover:-translate-y-0.5">
      Sign In
    </a>
    <a href="/register" class="px-8 py-3 bg-white text-blue-600 font-semibold rounded-lg shadow-lg hover:shadow-xl border-2 border-blue-600 hover:bg-blue-50 transition-all duration-300 transform hover:-translate-y-0.5">
      Get Started
    </a>
  </div>

  <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto pt-8">
    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-xl border border-blue-100">
      <div class="text-3xl mb-3">🔒</div>
      <h3 class="font-semibold text-gray-800 mb-2">Secure</h3>
      <p class="text-sm text-gray-600">Enterprise-grade security</p>
    </div>
    <div class="bg-gradient-to-br from-purple-50 to-pink-50 p-6 rounded-xl border border-purple-100">
      <div class="text-3xl mb-3">⚡</div>
      <h3 class="font-semibold text-gray-800 mb-2">Fast</h3>
      <p class="text-sm text-gray-600">Lightning-fast performance</p>
    </div>
    <div class="bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-xl border border-green-100">
      <div class="text-3xl mb-3">✨</div>
      <h3 class="font-semibold text-gray-800 mb-2">Modern</h3>
      <p class="text-sm text-gray-600">Built with latest technologies</p>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
