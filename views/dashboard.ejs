<%- include("partials/header") %>

<div class="space-y-6">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-2">User Dashboard</h2>
    <div class="w-16 h-1 bg-gradient-to-r from-blue-500 to-indigo-500 mx-auto rounded-full"></div>
  </div>

  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-100 shadow-lg">
    <div class="flex items-center justify-between mb-4">
      <div>
        <p class="text-sm text-gray-500 mb-1">Welcome back,</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= user.name %></h3>
      </div>
      <div class="bg-white rounded-full p-4 shadow-md">
        <span class="text-3xl">👤</span>
      </div>
    </div>
    
    <div class="mt-4 pt-4 border-t border-blue-200">
      <div class="flex items-center space-x-2">
        <span class="text-sm font-medium text-gray-600">Role:</span>
        <span class="px-3 py-1 bg-gradient-to-r from-purple-500 to-pink-500 text-white text-sm font-semibold rounded-full">
          <%= user.role %>
        </span>
      </div>
    </div>
  </div>

  <% if (user.role === "admin") { %>
    <a href="/admin"
       class="block text-center bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold py-3 px-6 rounded-lg hover:from-purple-700 hover:to-pink-700 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5">
       <span class="flex items-center justify-center space-x-2">
         <span>⚡</span>
         <span>Go to Admin Panel</span>
       </span>
    </a>
  <% } %>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-md hover:shadow-lg transition-shadow">
      <div class="text-2xl mb-2">📊</div>
      <h4 class="font-semibold text-gray-800 mb-1">Statistics</h4>
      <p class="text-sm text-gray-500">View your account stats</p>
    </div>
    <div class="bg-white p-5 rounded-lg border border-gray-200 shadow-md hover:shadow-lg transition-shadow">
      <div class="text-2xl mb-2">⚙️</div>
      <h4 class="font-semibold text-gray-800 mb-1">Settings</h4>
      <p class="text-sm text-gray-500">Manage your preferences</p>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
