<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= salon.name %> | Salso Premium
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #FBFCFE;
    }

    .gold-gradient {
      background: linear-gradient(135deg, #E2B171 0%, #B88A44 100%);
    }

    .glass-nav {
      backdrop-filter: blur(12px);
      background: rgba(255, 255, 255, 0.8);
    }

    .service-card:hover {
      border-color: #E2B171;
      background: #FFFDF9;
    }

    .sticky-booking {
      position: sticky;
      top: 100px;
    }
  </style>
</head>

<body class="text-[#0F172A] pb-24 md:pb-12">

  <header class="sticky top-0 z-50 glass-nav border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <button onclick="history.back()"
        class="flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-[#0F172A]">
        <i class="fa-solid fa-arrow-left"></i> Back
      </button>
      <h1 class="text-xl font-extrabold tracking-tighter">SALSO<span class="text-[#E2B171]">.</span></h1>
      <button class="w-10 h-10 rounded-full border border-slate-100 flex items-center justify-center">
        <i class="fa-solid fa-share-nodes text-slate-400"></i>
      </button>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 md:px-8 mt-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      <div class="lg:col-span-2">
        <div class="relative h-64 md:h-[450px] rounded-[2.5rem] overflow-hidden shadow-2xl mb-8">
          <img src="<%= salon.image_url %>" class="w-full h-full object-cover">
          <div
            class="absolute bottom-6 left-6 bg-white/90 backdrop-blur-md px-4 py-2 rounded-2xl flex items-center gap-2 shadow-lg">
            <i class="fa-solid fa-star text-[#E2B171]"></i>
            <span class="font-bold text-sm">
              <%= salon.rating %> (120+ Reviews)
            </span>
          </div>
        </div>

        <div class="flex justify-between items-start mb-6">
          <div>
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tighter mb-2">
              <%= salon.name %>
            </h2>
            <p class="text-slate-400 font-medium flex items-center gap-2">
              <i class="fa-solid fa-location-dot text-[#E2B171]"></i>
              <%= salon.location %>
            </p>
          </div>
          <span
            class="bg-[#0F172A] text-[#E2B171] px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest mt-2">
            Elite Studio
          </span>
        </div>

        <hr class="border-slate-100 my-8">

        <h3 class="text-2xl font-extrabold mb-6">Service Menu</h3>
        <div class="space-y-4">
          <% if (typeof features !=='undefined' && features.length> 0) { %>
            <% features.forEach(feature=> { %>
              <div
                class="service-card group border border-slate-100 p-6 rounded-[2rem] flex justify-between items-center transition-all cursor-pointer bg-white">
                <div class="flex gap-5 items-center">
                  <div
                    class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center group-hover:bg-[#E2B171]/10 transition">
                    <i class="fa-solid fa-scissors text-slate-400 group-hover:text-[#E2B171]"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-800 text-[23px]">
                      <%= feature.feature_name %>
                    </h4>
                    <p class="text-[12px] text-slate-400 font-medium">
                      Duration: <%= feature.duration_minutes || 'N/A' %>
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-6">
                  <span class="font-extrabold text-[#0F172A]">₹<%= feature.price || '0' %>
                  </span>
                  <div class="flex items-center gap-2">
                    <button onclick="removePrice(<%= feature.price || feature.feature_price || 0 %>)"
                      class="w-8 h-8 rounded-full border-2 border-slate-100 flex items-center justify-center hover:bg-[#0F172A] hover:border-[#0F172A] transition">
                      <i class="fa-solid fa-minus text-slate-400 hover:text-white text-xs"></i>
                    </button>
                    <button onclick="addPrice(<%= feature.price || feature.feature_price || 0 %>)"
                      class="w-8 h-8 rounded-full border-2 border-slate-100 flex items-center justify-center hover:bg-[#0F172A] hover:border-[#0F172A] transition">
                      <i class="fa-solid fa-plus text-slate-400 hover:text-white text-xs"></i>
                    </button>
                  </div>
                </div>
              </div>
              <% }); %>
                <% } else { %>
                  <div class="text-center py-8 text-slate-400">
                    <p class="text-sm font-medium">No features available for this salon</p>
                  </div>
                  <% } %>
        </div>
      </div>

      <div class="lg:col-span-1">
        <div class="sticky-booking bg-white border border-slate-100 p-8 rounded-[3rem] shadow-xl shadow-slate-200/50">
          <h3 class="text-xl font-extrabold mb-6 text-center">Schedule Session</h3>

          <div class="flex gap-3 overflow-x-auto no-scrollbar mb-8">
            <% ['Mon', 'Tue' , 'Wed' , 'Thu' , 'Fri' ].forEach((day, i)=> { %>
              <div
                class="flex-shrink-0 w-16 h-20 <%= i === 0 ? 'gold-gradient text-white' : 'bg-slate-50 text-slate-400' %> rounded-2xl flex flex-col items-center justify-center cursor-pointer hover:shadow-md transition">
                <span class="text-[10px] font-bold uppercase">
                  <%= day %>
                </span>
                <span class="text-lg font-black">
                  <%= 24 + i %>
                </span>
              </div>
              <% }); %>
          </div>

          <div class="grid grid-cols-3 gap-3 mb-10">
            <% ['10:00', '12:30' , '14:00' , '17:00' , '18:30' , '20:00' ].forEach(time=> { %>
              <button
                class="py-3 text-[11px] font-bold rounded-xl border border-slate-100 hover:border-[#E2B171] hover:text-[#E2B171] transition">
                <%= time %>
              </button>
              <% }); %>
          </div>

          <div class="space-y-3 mb-8">
            <div class="flex justify-between text-xs font-medium">
              <span class="text-slate-400">Service Subtotal</span>
              <span id="totalAmount" class="font-bold">₹899</span>
            </div>
            <div class="flex justify-between text-xs font-medium">
              <span class="text-slate-400">Convenience Fee</span>
              <span class="font-bold">₹49</span>
            </div>
            <div class="flex justify-between items-center pt-3 border-t border-slate-50">
              <span class="font-extrabold">Total Amount</span>
              <span id="totalAmount1" class="text-xl font-black text-[#0F172A]">₹0</span>
            </div>
          </div>

          <button
            class="w-full gold-gradient text-[#0F172A] py-5 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg shadow-[#E2B171]/20 hover:scale-[1.02] transition active:scale-95">
            Confirm Reservation
          </button>

          <p class="text-center text-[10px] text-slate-400 mt-6 font-medium">
            <i class="fa-solid fa-shield-check mr-1"></i> Secure checkout powered by SALSO Pay
          </p>
        </div>
      </div>

    </div>
  </main>

  <div
    class="fixed bottom-0 left-0 right-0 p-4 bg-white/80 backdrop-blur-xl border-t border-slate-100 md:hidden flex justify-between items-center z-50">
    <div>
      <span class="text-[10px] font-black text-slate-400 uppercase">Items (1)</span>
      <p id="mobileTotalAmount" class="text-lg font-black">₹0</p>
    </div>
    <button
      class="gold-gradient text-[#0F172A] px-10 py-4 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg">
      Confirm
    </button>
  </div>

  <script>
    let total = 0;

    function updateUI() {
      let grandtotal = total + 49; // Adding convenience fee
      document.getElementById("totalAmount").innerText = "₹" + total;
      document.getElementById("mobileTotalAmount").innerText = "₹" + total;
      document.getElementById("totalAmount1").innerText = "₹" + grandtotal;
    }

    function addPrice(price) {
      total += parseFloat(price);
      updateUI();
    }

    function removePrice(price) {
      total -= parseFloat(price);
      if (total < 0) total = 0;
      updateUI();
    }
  </script>
</body>

</html>