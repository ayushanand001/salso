<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salso Premium | Luxury Grooming</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -0.01em;
        }

        .gold-gradient {
            background: linear-gradient(135deg, #E2B171 0%, #B88A44 100%);
        }

        .glass-nav {
            backdrop-filter: blur(12px);
            background: rgba(255, 255, 255, 0.8);
        }
    </style>
</head>

<body class="bg-[#FBFCFE] text-[#0F172A] min-h-screen">

    <div class="min-h-screen bg-[#FBFCFE] p-6 lg:p-20 font-['Plus_Jakarta_Sans',sans-serif]">
        <div class="max-w-4xl mx-auto">

            <a href="/order-details"
                class="inline-flex items-center gap-3 text-slate-400 hover:text-[#E2B171] mb-12 transition-all group">
                <div
                    class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center group-hover:border-[#E2B171] group-hover:bg-[#E2B171]/5 transition-all">
                    <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em]">Return to Ledger</span>
            </a>

            <div
                class="bg-white rounded-[3.5rem] shadow-[0_32px_64px_-16px_rgba(15,23,42,0.1)] overflow-hidden border border-slate-100">

                <div class="relative h-64 flex items-end p-10 lg:p-14">
                    <img src="<%= order.image_url %>" class="absolute inset-0 w-full h-full object-cover z-0"
                        alt="Salon Visual">
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0F172A] via-[#0F172A]/40 to-transparent z-10">
                    </div>

                    <div class="relative z-20 flex justify-between items-end w-full">
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <span class="relative flex h-3 w-3">
                                    <span
                                        class="animate-ping absolute inline-flex h-full w-full rounded-full <%= order.status === 'scheduled' ? 'bg-blue-400' : 'bg-green-400' %> opacity-75"></span>
                                    <span
                                        class="relative inline-flex rounded-full h-3 w-3 <%= order.status === 'scheduled' ? 'bg-blue-500' : 'bg-green-500' %>"></span>
                                </span>
                                <span
                                    class="text-white text-[10px] font-black uppercase tracking-[0.4em] drop-shadow-md">
                                    <%= order.status %>
                                </span>
                            </div>
                            <h1 class="text-5xl lg:text-6xl font-black text-white tracking-tighter leading-none">
                                <%= order.salon_name %>
                            </h1>
                        </div>
                        <div class="text-right">
                            <p class="text-white/40 text-[9px] font-black uppercase tracking-[0.5em] mb-1">Transaction
                                Token</p>
                            <p class="text-white text-sm font-bold font-mono">#ORD-<%= order.id %>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="p-10 lg:p-16 grid grid-cols-1 lg:grid-cols-2 gap-20">
                    <div>
                        <div class="flex items-center gap-3 mb-8">
                            <div class="h-[1px] w-8 bg-[#E2B171]"></div>
                            <h3 class="text-[#E2B171] text-[10px] font-black uppercase tracking-[0.5em]">Service
                                Blueprint</h3>
                        </div>

                        <div class="space-y-4">
                            <% const services=(order.feature_name || "" ).split(',').filter(s=> s.trim() !== ""); %>
                                <% services.forEach(service=> { %>
                                    <div
                                        class="flex justify-between items-center p-5 bg-slate-50 rounded-2xl border border-slate-100 group hover:border-[#E2B171]/30 transition-all">
                                        <span
                                            class="text-lg font-black text-[#0F172A] group-hover:text-[#E2B171] transition-colors tracking-tight">
                                            <%= service.trim() %>
                                        </span>
                                        <div
                                            class="w-6 h-6 rounded-full bg-green-500 flex items-center justify-center shadow-lg shadow-green-500/20">
                                            <i class="fa-solid fa-check text-[10px] text-white"></i>
                                        </div>
                                    </div>
                                    <% }) %>
                        </div>
                    </div>

                    <div class="space-y-12">
                        <div>
                            <h3
                                class="text-slate-400 text-[10px] font-black uppercase tracking-[0.5em] mb-6 flex items-center gap-2">
                                <i class="fa-regular fa-clock"></i> Arrival Window
                            </h3>
                            <div class="bg-[#0F172A] p-6 rounded-[2rem] text-white">
                                <p class="text-3xl font-black tracking-tight mb-1">
                                    <%= order.dayslot %>
                                </p>
                                <p class="text-sm font-bold text-white/50 uppercase tracking-widest">
                                    <%= order.timeslot %>
                                </p>
                            </div>
                        </div>

                        <div>
                            <h3
                                class="text-slate-400 text-[10px] font-black uppercase tracking-[0.5em] mb-6 flex items-center gap-2">
                                <i class="fa-regular fa-map"></i> Navigation
                            </h3>
                            <div class="group cursor-pointer">
                                <p
                                    class="text-[#0F172A] text-xl font-black leading-tight mb-4 group-hover:text-[#E2B171] transition-colors">
                                    <%= order.address %>
                                </p>
                                <a href="<%= order.google_maps %>" target="_blank"
                                    class="inline-flex items-center gap-3 px-6 py-3 bg-white border border-slate-200 rounded-xl text-[#0F172A] text-[10px] font-black uppercase tracking-widest hover:bg-[#0F172A] hover:text-white hover:border-[#0F172A] transition-all shadow-sm">
                                    Open Google Maps <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div
                    class="bg-slate-50 p-10 lg:p-14 flex flex-col lg:flex-row justify-between items-center gap-8 border-t border-slate-100">
                    <div class="flex items-center gap-6">
                        <div
                            class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-sm border border-slate-100">
                            <i class="fa-solid fa-shield-halved text-[#E2B171]"></i>
                        </div>
                        <div>
                            <p class="text-[#0F172A] text-xs font-black uppercase tracking-widest mb-1">Authenticated
                                Receipt
                            </p>
                            <p class="text-slate-400 text-[9px] font-medium leading-relaxed max-w-[240px]">
                                Transaction secured via SHA-512 encryption protocols for Salso Premium Partners.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-4 w-full lg:w-auto">
                        <button onclick="window.print()"
                            class="flex-1 lg:flex-none px-10 py-5 bg-[#0F172A] text-white text-[10px] font-black uppercase tracking-widest rounded-2xl hover:bg-[#E2B171] hover:shadow-2xl hover:shadow-[#E2B171]/20 transition-all active:scale-95">
                            Download PDF Receipt
                        </button>
                    </div>
                </div>
            </div>

            <div class="mt-12 text-center">
                <p class="text-slate-300 text-[9px] font-black uppercase tracking-[0.8em]">Salso Premium Experience
                    &copy; 2025
                </p>
            </div>
        </div>
    </div>

    <%- include("partials/footer") %>