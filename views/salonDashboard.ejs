<%- include("partials/header") %>

<div class="fixed inset-0 w-screen h-screen bg-white z-[9999] flex flex-col lg:flex-row overflow-hidden font-['Plus_Jakarta_Sans',sans-serif]">

  <% if (!salon) { %>
    <div class="w-full h-full flex items-center justify-center bg-slate-50">
      <h2 class="text-5xl font-black text-slate-200 uppercase tracking-[1em]">System Offline</h2>
    </div>
  <% } else { %>

    <aside class="w-full lg:w-[40vw] h-full relative p-12 lg:p-20 flex flex-col justify-between shrink-0 overflow-hidden shadow-[10px_0_50px_rgba(0,0,0,0.1)]">
      
      <img src="<%= salon.image_url %>" class="absolute inset-0 w-full h-full object-cover z-0" alt="<%= salon.name %>">
      
      <div class="absolute inset-0 bg-[#0F172A]/85 z-10"></div>

      <div class="relative z-20">
        <span class="inline-block px-4 py-1.5 bg-[#E2B171] text-white text-[10px] font-black uppercase tracking-[0.5em] rounded mb-10">
          GLOBAL ENTERPRISE PARTNER
        </span>
        
        <h1 class="text-7xl md:text-8xl lg:text-[7vw] font-black text-white tracking-tighter leading-[0.85] mb-12">
          <%= salon.name %>
        </h1>

        <div class="space-y-12">
          <div class="flex items-start gap-8">
            <div class="w-16 h-16 rounded-3xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
              <i class="fa-solid fa-location-dot text-2xl text-[#E2B171]"></i>
            </div>
            <div class="min-w-0">
              <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-2">Primary Headquarters</p>
              <p class="text-white text-2xl font-bold truncate"><%= salon.location %></p>
              <p class="text-slate-300 text-base mt-2 leading-relaxed max-w-sm"><%= salon.address %></p>
            </div>
          </div>

          <div class="flex items-start gap-8">
            <div class="w-16 h-16 rounded-3xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
              <i class="fa-solid fa-phone text-2xl text-[#E2B171]"></i>
            </div>
            <div>
              <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-2">Direct Operations Line</p>
              <p class="text-white text-2xl font-bold"><%= salon.phone %></p>
              <p class="text-slate-300 text-sm mt-1 uppercase tracking-widest"><%= salon.email %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative z-20 pt-10 border-t border-white/20">
        <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.5em]">COMMAND CENTER &copy; 2025</p>
      </div>
    </aside>

    <main class="w-full lg:w-[60vw] h-full bg-white flex flex-col shrink-0">
      <div class="flex-1 overflow-y-auto p-12 lg:p-20 custom-scroll">
        <div class="flex items-end justify-between mb-20">
          <div>
            <h2 class="text-6xl lg:text-7xl font-black text-[#0F172A] tracking-tighter leading-none">Appointment Ledger</h2>
            <div class="flex items-center gap-3 mt-4">
              <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></span>
              <p class="text-slate-400 text-xs font-black uppercase tracking-[0.4em]">Live Transaction Stream</p>
            </div>
          </div>
          <button class="px-12 py-5 bg-[#0F172A] text-white font-black rounded-2xl hover:bg-[#E2B171] transition-all text-xs uppercase tracking-widest shadow-2xl">
            Export .CSV
          </button>
        </div>

        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-4 border-[#0F172A]">
              <th class="pb-10 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Order Profile</th>
              <th class="pb-10 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Schedule</th>
              <th class="pb-10 text-right text-xs font-black uppercase tracking-[0.5em] text-slate-400">Gateway Status</th>
            </tr>
          </thead>
          <tbody class="divide-y-2 divide-slate-100">
            <% if (bookings && bookings.length > 0) { %>
              <% bookings.forEach(booking => { %>
                <tr class="group hover:bg-[#F8FAFC] transition-all">
                  <td class="py-16">
                    <span class="text-4xl font-black text-[#0F172A] group-hover:text-[#E2B171] transition-colors leading-none block mb-2">
                        <%= booking.feature_name %>
                    </span>
                    <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">ID: #ORD-<%= booking.id %></span>
                  </td>
                  <td class="py-16">
                    <span class="text-2xl font-black text-[#0F172A] block"><%= booking.dayslot %></span>
                    <span class="text-base font-bold text-slate-400 uppercase tracking-tighter"><%= booking.timeslot %></span>
                  </td>
                  <td class="py-16 text-right">
                    <span class="inline-block px-10 py-4 rounded-full text-[11px] font-black uppercase tracking-[0.2em] shadow-lg
                      <%= booking.status === 'scheduled' ? 'bg-blue-50 text-blue-600 border border-blue-100' : 'bg-green-50 text-green-600 border border-green-100' %>">
                      <%= booking.status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" class="py-60 text-center">
                  <p class="text-slate-200 font-black uppercase tracking-[1em] text-2xl">Ledger Empty</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>

  <% } %>

</div>

<style>
  body { overflow: hidden !important; }
  .custom-scroll::-webkit-scrollbar { width: 8px; }
  .custom-scroll::-webkit-scrollbar-track { background: #fff; }
  .custom-scroll::-webkit-scrollbar-thumb { background: #f1f5f9; border-radius: 0; }
  .custom-scroll::-webkit-scrollbar-thumb:hover { background: #E2B171; }
</style>

