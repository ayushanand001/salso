<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP | Salso Premium</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      letter-spacing: -0.01em;
    }
  </style>
</head>

<body class="min-h-screen flex items-center justify-center bg-[#FBFCFE] p-4">

  <div class="bg-white shadow-xl rounded-[2rem] w-full max-w-md p-8 border border-slate-100">

    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-[#0F172A] rounded-2xl mb-4 shadow-lg">
        <i class="fa-solid fa-key text-2xl text-[#E2B171]"></i>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tighter text-[#0F172A] mb-2">
        OTP Verification
      </h2>
      <p class="text-slate-400 text-xs font-bold uppercase tracking-widest">SALSO Premium</p>
    </div>

    <p class="text-sm text-slate-600 text-center mb-8 bg-slate-50 p-4 rounded-2xl border border-slate-100 font-medium">
      We've sent a 6-digit OTP to <br>
      <span class="font-extrabold text-[#0F172A] text-base block mt-2">
        <%= email %>
      </span>
    </p>

    <% if (error) { %>
      <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
        <div class="flex items-center">
          <i class="fa-solid fa-circle-exclamation text-red-500 mr-2"></i>
          <span class="text-red-600 text-sm font-bold">
            <%= error %>
          </span>
        </div>
      </div>
      <% } %>

        <form method="POST" action="/verify-otp" class="space-y-6">

          <input type="hidden" name="email" value="<%= email %>" />

          <div>
            <label class="block text-sm font-bold text-[#0F172A] mb-3 text-center">
              Enter OTP Code
            </label>
            <input type="text" name="otp" maxlength="6" required
              class="w-full px-4 py-4 border-2 border-slate-100 rounded-2xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-[#E2B171] focus:border-[#E2B171] text-center tracking-[0.5em] text-2xl font-extrabold transition-all duration-200"
              placeholder="000000" 
              pattern="[0-9]{6}"
              inputmode="numeric" />
            <p class="text-xs text-slate-400 text-center mt-2 font-medium">Enter the 6-digit code sent to your email</p>
          </div>

          <button type="submit"
            class="w-full bg-[#0F172A] text-white font-extrabold py-4 rounded-2xl hover:bg-[#E2B171] shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 uppercase text-xs tracking-widest">
            Verify OTP
          </button>
        </form>

        <div class="text-center mt-8 pt-6 border-t border-slate-100">
          <p class="text-sm text-slate-400 mb-2 font-medium">
            Didn't receive OTP?
          </p>
          <a href="/resendOtp/?email=<%=email%>"
            class="inline-block text-sm text-[#E2B171] hover:text-[#B88A44] font-extrabold hover:underline transition-colors duration-200">
            Resend OTP Code
          </a>
        </div>

  </div>

</body>
</html>