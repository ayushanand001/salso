<%- include("partials/header") %>

<div class="text-center space-y-8 pb-12">
  <div class="space-y-4">
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-[#0F172A]">
      Welcome to <span class="text-[#E2B171]">SALSO</span>
    </h1>
    <p class="text-slate-400 text-xs font-bold uppercase tracking-widest">Premium Luxury Grooming</p>
  </div>

  <p class="text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto font-medium">
    Experience curated luxury salons with premium services tailored for the modern gentleman.
  </p>

  <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-10">
    <a href="/login" class="px-10 py-4 bg-[#0F172A] text-white font-extrabold rounded-2xl shadow-xl hover:bg-[#E2B171] transition-all duration-300 transform hover:-translate-y-1 uppercase text-xs tracking-widest">
      Sign In
    </a>
    <a href="/register" class="px-10 py-4 bg-white text-[#0F172A] font-extrabold rounded-2xl shadow-xl border-2 border-slate-100 hover:border-[#E2B171] transition-all duration-300 transform hover:-translate-y-1 uppercase text-xs tracking-widest">
      Get Started
    </a>
  </div>

  <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto pt-8">
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all">
      <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-4 mx-auto">
        <i class="fa-solid fa-shield-check text-2xl text-[#E2B171]"></i>
      </div>
      <h3 class="font-extrabold text-[#0F172A] mb-2">Secure</h3>
      <p class="text-sm text-slate-400 font-medium">Enterprise-grade security</p>
    </div>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all">
      <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-4 mx-auto">
        <i class="fa-solid fa-bolt text-2xl text-[#E2B171]"></i>
      </div>
      <h3 class="font-extrabold text-[#0F172A] mb-2">Fast</h3>
      <p class="text-sm text-slate-400 font-medium">Lightning-fast booking</p>
    </div>
    <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all">
      <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-4 mx-auto">
        <i class="fa-solid fa-crown text-2xl text-[#E2B171]"></i>
      </div>
      <h3 class="font-extrabold text-[#0F172A] mb-2">Luxury</h3>
      <p class="text-sm text-slate-400 font-medium">Premium experience</p>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
