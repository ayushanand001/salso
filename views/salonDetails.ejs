<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Salon Details</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    * { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-gray-50 via-teal-50 to-cyan-50 min-h-screen">

  <!-- Navbar -->
  <nav class="bg-gradient-to-r from-teal-900 via-cyan-800 to-emerald-900 shadow-xl border-b border-teal-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/salons" class="flex items-center space-x-2 text-cyan-200 hover:text-white font-medium transition-colors duration-200 group">
          <span class="group-hover:-translate-x-1 transition-transform duration-200">←</span>
          <span>Back to Salons</span>
        </a>
        <div class="flex items-center space-x-2">
          <span class="text-2xl">💇</span>
          <span class="text-xl font-bold text-cyan-200">Salon Finder</span>
        </div>
      </div>
    </div>
  </nav>

  <!-- Salon Details Card -->
  <div class="flex justify-center items-center min-h-[calc(100vh-4rem)] px-4 py-10">
    <div class="bg-white shadow-2xl rounded-2xl w-full max-w-2xl overflow-hidden border border-gray-100">
      
      <!-- Header with Gradient -->
      <div class="bg-gradient-to-r from-teal-500 via-cyan-500 to-emerald-500 p-8 text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-white/20 rounded-full mb-4 backdrop-blur-sm">
          <span class="text-4xl">💇‍♀️</span>
        </div>
        <h2 class="text-4xl font-bold text-white mb-2">
          <%= salon.name %>
        </h2>
        <div class="w-24 h-1 bg-white/50 mx-auto rounded-full"></div>
      </div>

      <!-- Details Section -->
      <div class="p-8">
        <div class="space-y-6">
          
          <!-- Location -->
          <div class="flex items-start space-x-4 p-5 bg-gradient-to-r from-teal-50 to-cyan-50 rounded-xl border border-teal-100 hover:shadow-md transition-shadow duration-200">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-teal-500 to-cyan-500 rounded-lg flex items-center justify-center">
              <span class="text-2xl">📍</span>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
              <p class="text-lg text-gray-800 font-semibold">
                <%= salon.location %>
              </p>
            </div>
          </div>

          <!-- Phone -->
          <div class="flex items-start space-x-4 p-5 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl border border-blue-100 hover:shadow-md transition-shadow duration-200">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-lg flex items-center justify-center">
              <span class="text-2xl">📞</span>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone</p>
              <p class="text-lg text-gray-800 font-semibold">
                <%= salon.phone %>
              </p>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start space-x-4 p-5 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border border-green-100 hover:shadow-md transition-shadow duration-200">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-lg flex items-center justify-center">
              <span class="text-2xl">📧</span>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p>
              <p class="text-lg text-gray-800 font-semibold">
                <%= salon.email %>
              </p>
            </div>
          </div>

        </div>

        <!-- Action Buttons -->
        <div class="mt-8 pt-8 border-t border-gray-200 flex flex-col sm:flex-row gap-4">
          <a href="/salons" 
            class="flex-1 text-center px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-lg hover:bg-gray-200 shadow-sm hover:shadow-md transition-all duration-200">
            ← Back to Salons
          </a>

          <button class="flex-1 bg-gradient-to-r from-teal-600 to-cyan-600 text-white font-semibold py-3 px-6 rounded-lg hover:from-teal-700 hover:to-cyan-700 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105">
            Book Appointment
          </button>
        </div>

      </div>

    </div>
  </div>

</body>
</html>
