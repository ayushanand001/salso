<!DOCTYPE html>

<html lang="en">



<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Salso Premium | Luxury Grooming</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      letter-spacing: -0.01em;
    }



    .glass-dark {

      backdrop-filter: blur(12px);

      background: rgba(15, 23, 42, 0.8);

      border-bottom: 1px solid rgba(255, 255, 255, 0.1);

    }



    .luxury-card {

      background: white;

      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);

      border: 1px solid #f1f5f9;

    }



    .luxury-card:hover {

      transform: translateY(-8px);

      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);

      border-color: #E2B171;

    }



    .gold-gradient {

      background: linear-gradient(135deg, #E2B171 0%, #B88A44 100%);

    }



    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

</head>



<body class="bg-[#FBFCFE] text-[#0F172A] pb-24 md:pb-0">



  <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">

    <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 flex justify-between items-center">

      <div class="flex items-center gap-10">

        <h1 class="text-2xl font-extrabold tracking-tighter text-[#0F172A] hidden md:block">

          SALSO<span class="text-[#E2B171]">.</span>

        </h1>

        <div class="flex flex-col">

          <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Current Location</span>

          <div class="flex items-center gap-1 cursor-pointer group">

            <span id="location-status" class="font-bold text-xs md:text-sm group-hover:text-[#E2B171] transition">Not
              updated</span>

            <i class="fa-solid fa-location-dot text-[10px] text-[#E2B171]"></i>

          </div>

        </div>

      </div>



      <div class="hidden md:flex relative w-1/3">

        <input type="text" placeholder="Search luxury services..."
          class="w-full h-11 bg-slate-50 border border-slate-100 rounded-full pl-12 pr-4 text-sm focus:ring-2 focus:ring-[#E2B171] focus:bg-white transition-all outline-none">

        <i class="fa-solid fa-magnifying-glass absolute left-5 top-1/2 -translate-y-1/2 text-slate-300"></i>

      </div>



      <div class="flex items-center gap-6">

        <button
          class="hidden md:block text-xs font-bold uppercase tracking-widest text-slate-500 hover:text-[#E2B171]">Memberships</button>

        <form action="/logout" method="POST">

          <button
            class="w-10 h-10 rounded-xl bg-[#0F172A] text-white flex items-center justify-center hover:bg-[#E2B171] transition-all shadow-lg">

            <i class="fa-solid fa-crown text-sm"></i>

          </button>

        </form>

      </div>

    </div>



    <div class="px-5 pb-4 md:hidden">

      <div class="relative">

        <input type="text" placeholder="What are you looking for?"
          class="w-full h-12 bg-slate-100 border-none rounded-xl pl-12 pr-4 text-sm focus:ring-2 focus:ring-[#E2B171] outline-none">

        <i class="fa-solid fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>

      </div>

    </div>

  </header>



  <main class="max-w-7xl mx-auto px-4 md:px-8 mt-8">



    <section
      class="hidden md:block mb-12 h-60 rounded-[2.5rem] bg-[#0F172A] p-12 text-white relative overflow-hidden shadow-2xl">

      <div class="relative z-10 max-w-md">

        <span class="text-[#E2B171] font-bold text-xs uppercase tracking-[0.3em]">Exclusive Offer</span>

        <h2 class="text-4xl font-extrabold mt-2 leading-tight">Elevate Your Lifestyle Presence.</h2>

        <p class="mt-4 text-slate-400 text-sm">Complimentary facial on your first grooming session.</p>

        <button
          class="mt-6 gold-gradient text-[#0F172A] px-8 py-3 rounded-full font-extrabold text-xs uppercase tracking-wider hover:scale-105 transition">Reserve
          Now</button>

      </div>

      <div
        class="absolute right-0 top-0 h-full w-1/2 bg-[url('https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=800')] bg-cover opacity-40">
      </div>

    </section>



    <div class="flex gap-3 overflow-x-auto pb-4 no-scrollbar">

      <button
        class="px-6 py-2.5 bg-[#0F172A] text-white rounded-full text-[11px] font-bold uppercase tracking-wider shadow-xl">All
        Studios</button>

      <button
        class="px-6 py-2.5 bg-white border border-slate-100 rounded-full text-[11px] font-bold uppercase tracking-wider text-slate-500 hover:border-[#E2B171]">Top
        Rated</button>

      <button
        class="px-6 py-2.5 bg-white border border-slate-100 rounded-full text-[11px] font-bold uppercase tracking-wider text-slate-500 hover:border-[#E2B171]">Home
        Service</button>

    </div>



    <div class="flex justify-between items-end mt-10 mb-8">

      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tighter text-[#0F172A]">Curated Selection</h2>

      <a href="#"
        class="text-[#E2B171] text-xs font-bold uppercase tracking-widest border-b-2 border-[#E2B171] pb-1">View All</a>

    </div>



    <div id="salonContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

      <% salons.forEach(salon=> { %>

        <div class="luxury-card group rounded-[2rem] overflow-hidden flex flex-col h-full">

          <div class="relative overflow-hidden h-60">

            <img src="<%= salon.image_url %>"
              class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700">

            <div
              class="absolute top-5 left-5 bg-white/90 backdrop-blur-md px-3 py-1 rounded-lg flex items-center gap-1.5 shadow-sm">

              <i class="fa-solid fa-star text-[#E2B171] text-[10px]"></i>

              <span class="text-[11px] font-bold text-[#0F172A]">
                <%= salon.rating %>
              </span>

            </div>

          </div>



          <div class="p-7 flex flex-col flex-grow">

            <h3 class="font-extrabold text-lg text-[#0F172A] group-hover:text-[#E2B171] transition-colors">

              <%= salon.name %>

            </h3>

            <p class="text-slate-400 text-[11px] font-bold uppercase tracking-widest mt-1">

              <%= salon.location %>

            </p>



            <div class="flex items-center gap-4 mt-6 mb-8 text-slate-400">

              <div class="flex items-center gap-1.5">

                <i class="fa-solid fa-hourglass-start text-[10px] text-[#E2B171]"></i>

                <span class="text-[10px] font-bold italic">Quick 15m</span>

              </div>

              <div class="flex items-center gap-1.5">

                <i class="fa-solid fa-diamond text-[10px] text-[#E2B171]"></i>

                <span class="text-[10px] font-bold uppercase tracking-tighter">Premium</span>

              </div>

            </div>



            <div class="mt-auto flex justify-between items-center border-t border-slate-50 pt-6">

              <div class="flex flex-col">

                <span class="text-[9px] text-slate-400 font-black uppercase">From</span>

                <span class="text-xl font-extrabold text-[#0F172A]">₹<%= Math.floor(Math.random() * 500) + 500 %></span>

              </div>

              <a href="/salons/<%= salon.id %>"
                class="bg-[#0F172A] text-white px-7 py-3 rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#E2B171] transition-all active:scale-95 shadow-lg shadow-slate-200 inline-block text-center">
                Book

              </a>

            </div>

          </div>

        </div>

        <% }); %>

    </div>

  </main>



  <nav
    class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-50 px-8 py-5 flex justify-between items-center z-50 md:hidden rounded-t-[2rem] shadow-[0_-10px_40px_rgba(0,0,0,0.05)]">

    <div class="flex flex-col items-center gap-1.5 text-[#0F172A]">

      <i class="fa-solid fa-compass text-lg"></i>

      <span class="text-[8px] font-black uppercase tracking-widest">Home</span>

    </div>

    <div class="flex flex-col items-center gap-1.5 text-slate-300">

      <i class="fa-solid fa-search text-lg"></i>

      <span class="text-[8px] font-black uppercase tracking-widest">Search</span>

    </div>

    <div class="flex flex-col items-center gap-1.5 text-slate-300">

      <i class="fa-solid fa-calendar text-lg"></i>

      <span class="text-[8px] font-black uppercase tracking-widest">Reservations</span>

    </div>

    <div class="flex flex-col items-center gap-1.5 text-slate-300">

      <i class="fa-solid fa-crown text-lg"></i>

      <span class="text-[8px] font-black uppercase tracking-widest">Elite</span>

    </div>

  </nav>



  <footer class="hidden md:block bg-[#0F172A] text-white mt-24 py-16">

    <div class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row justify-between items-center gap-8">

      <h1 class="text-2xl font-black tracking-tighter">SALSO<span class="text-[#E2B171]">.</span></h1>

      <p class="text-slate-500 text-xs font-bold uppercase tracking-widest">Premium Salon Network • 2025</p>

      <div class="flex gap-8 text-xs font-bold uppercase tracking-widest">

        <a href="#" class="hover:text-[#E2B171]">Legal</a>

        <a href="#" class="hover:text-[#E2B171]">Partners</a>

        <a href="#" class="hover:text-[#E2B171]">Support</a>

      </div>

    </div>

  </footer>

  <script>

    function getSalonDistance() {

      if (!navigator.geolocation) {
        console.log("Geolocation is not supported in your web browser!");
        return;
      }

      const options = {
        enableHighAccuracy: false,
        timeout: 15000,
        maximumAge: 0
      };

      navigator.geolocation.getCurrentPosition(success, error, options);

    }

    async function success(position) {

      const lat = position.coords.latitude;
      const long = position.coords.longitude;

      try {
        const response = await fetch(`https://api-bdc.io/data/reverse-geocode-client?latitude=${lat}&longitude=${long}&localityLanguage=en`);
        console.log(response);
        const data = await response.json();

        const city = data.city || data.locality || "unknown";
        const state = data.principalSubdivision + ", " + data.countryName;

        console.log(`User is in: ${city}, ${state}`);

        const locationStatus = document.getElementById('location-status');
        if (locationStatus) {
          locationStatus.innerText = `${city}, ${state}`;
        }

      } catch (error) {
        console.log("unable to fetch locality details");
      }
    }

    function error(err) {
      console.warn(`ERROR(${err.code}): ${err.message}`);
    }

    document.addEventListener("DOMContentLoaded", () => {
      getSalonDistance();

      // Search functionality
      let searchTimeout;
      const desktopSearchInput = document.querySelector('header input[type="text"]');
      const mobileSearchInput = document.querySelector('.md\\:hidden input[type="text"]');
      const salonContainer = document.getElementById('salonContainer');
      let originalSalonsHTML = null;

      // Store original HTML on page load
      if (salonContainer) {
        originalSalonsHTML = salonContainer.innerHTML;
      }

    async function performSearch(searchQuery) {
      try {
        const response = await fetch(`/api/salons/search?search=${encodeURIComponent(searchQuery)}`, {
          method: 'GET',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error('Search failed');
        }

        const salons = await response.json();
        updateSalonContainer(salons);
      } catch (error) {
        console.error('Error searching salons:', error);
        // On error, restore original salons
        if (originalSalonsHTML) {
          salonContainer.innerHTML = originalSalonsHTML;
        }
      }
    }

    function updateSalonContainer(salons) {
      salonContainer.innerHTML = '';
      
      if (salons.length === 0) {
        salonContainer.innerHTML = '<div class="col-span-full text-center py-12"><p class="text-slate-400 text-sm">No salons found</p></div>';
        return;
      }

      salons.forEach(salon => {
        const salonCard = document.createElement('div');
        salonCard.className = 'luxury-card group rounded-[2rem] overflow-hidden flex flex-col h-full';
        salonCard.innerHTML = `
          <div class="relative overflow-hidden h-60">
            <img src="${salon.image_url || 'https://via.placeholder.com/400x300'}"
              class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700">
            <div
              class="absolute top-5 left-5 bg-white/90 backdrop-blur-md px-3 py-1 rounded-lg flex items-center gap-1.5 shadow-sm">
              <i class="fa-solid fa-star text-[#E2B171] text-[10px]"></i>
              <span class="text-[11px] font-bold text-[#0F172A]">
                ${salon.rating || '4.5'}
              </span>
            </div>
          </div>
          <div class="p-7 flex flex-col flex-grow">
            <h3 class="font-extrabold text-lg text-[#0F172A] group-hover:text-[#E2B171] transition-colors">
              ${salon.name}
            </h3>
            <p class="text-slate-400 text-[11px] font-bold uppercase tracking-widest mt-1">
              ${salon.location}
            </p>
            <div class="flex items-center gap-4 mt-6 mb-8 text-slate-400">
              <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-hourglass-start text-[10px] text-[#E2B171]"></i>
                <span class="text-[10px] font-bold italic">Quick 15m</span>
              </div>
              <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-diamond text-[10px] text-[#E2B171]"></i>
                <span class="text-[10px] font-bold uppercase tracking-tighter">Premium</span>
              </div>
            </div>
            <div class="mt-auto flex justify-between items-center border-t border-slate-50 pt-6">
              <div class="flex flex-col">
                <span class="text-[9px] text-slate-400 font-black uppercase">From</span>
                <span class="text-xl font-extrabold text-[#0F172A]">₹${Math.floor(Math.random() * 500) + 500}</span>
              </div>
              <a href="/salons/${salon.id}"
                class="bg-[#0F172A] text-white px-7 py-3 rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#E2B171] transition-all active:scale-95 shadow-lg shadow-slate-200 inline-block text-center">
                Book
              </a>
            </div>
          </div>
        `;
        salonContainer.appendChild(salonCard);
      });
    }

    function handleSearch(event) {
      const searchQuery = event.target.value.trim();
      
      clearTimeout(searchTimeout);
      
      if (searchQuery === '') {
        // Restore original salons if search is cleared
        if (originalSalonsHTML) {
          salonContainer.innerHTML = originalSalonsHTML;
        }
        return;
      }

      searchTimeout = setTimeout(() => {
        performSearch(searchQuery);
      }, 300); // Debounce: wait 300ms after user stops typing
    }

      // Attach event listeners to search inputs
      if (desktopSearchInput) {
        desktopSearchInput.addEventListener('input', handleSearch);
      }
      if (mobileSearchInput) {
        mobileSearchInput.addEventListener('input', handleSearch);
      }
    });
  </script>


</body>

</html>