<!-- Tailwind + fonts (inline for this view) -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<!-- Inline header: translucent + backdrop blur -->
<header class="sticky top-0 z-50 bg-white/5 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-extrabold tracking-tighter text-black">
        <a href="/">SALSO<span class="text-[#E2B171]">.</span></a>
      </h1>
    </div>

    <div class="flex items-center gap-4 relative">
      <div class="relative">
        <button id="salonProfileBtn" onclick="toggleSalonProfile()" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-white/10 hover:bg-white/20 transition text-black">
          <% if (salon && salon.image_url) { %>
            <img src="<%= salon.image_url %>" alt="<%= salon.name %>" class="w-10 h-10 rounded-full object-cover" />
          <% } else { %>
            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-sm font-bold"><%= salon ? salon.name.charAt(0).toUpperCase() : 'S' %></div>
          <% } %>
          <span class="text-sm font-bold"><%= salon ? salon.name.split(' ')[0] : 'Salon' %></span>
          <i class="fa-solid fa-caret-down text-sm"></i>
        </button>

        <div id="salonProfileDropdown" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-lg shadow-lg text-slate-800 ring-1 ring-black/5 overflow-hidden">
          <div class="p-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
              <% if (salon && salon.image_url) { %>
                <img src="<%= salon.image_url %>" class="w-14 h-14 rounded-full object-cover" alt="<%= salon.name %>">
              <% } else { %>
                <div class="w-14 h-14 rounded-full bg-slate-200 flex items-center justify-center font-bold text-lg"> <%= salon ? salon.name.charAt(0).toUpperCase() : 'S' %> </div>
              <% } %>
              <div>
                <div class="font-bold text-sm"><%= salon ? salon.name : 'Salon' %></div>
                <div class="text-xs text-slate-500"><%= salon ? salon.location || salon.address || '' : '' %></div>
              </div>
            </div>
          </div>
          <div class="p-3 text-xs text-slate-600 space-y-2">
            <div><strong>Email:</strong> <span class="text-slate-800"><%= salon ? salon.email || '-' : '-' %></span></div>
            <div><strong>Phone:</strong> <span class="text-slate-800"><%= salon ? salon.phone || '-' : '-' %></span></div>
            <div class="truncate"><strong>Address:</strong> <span class="text-slate-800"><%= salon ? salon.address || '-' : '-' %></span></div>
          </div>
          <div class="p-3 border-t border-slate-100 flex gap-2">
            <a href="/salon/edit" class="flex-1 text-center px-3 py-2 bg-[#0F172A] text-white rounded text-sm">Edit Profile</a>
            <form action="/logout" method="POST" class="m-0">
              <button type="submit" class="px-3 py-2 bg-white/10 text-black rounded text-sm">Logout</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<div class="min-h-screen bg-white flex flex-col lg:flex-row overflow-auto font-['Plus_Jakarta_Sans',sans-serif]">

    <% if (!salon) { %>
      <div class="w-full h-full flex items-center justify-center bg-slate-50">
        <h2 class="text-5xl font-black text-slate-200 uppercase tracking-[1em]">System Offline</h2>
      </div>
      <% } else { %>

        <aside
          class="w-full lg:w-[40vw] h-full relative p-12 lg:p-20 flex flex-col justify-between shrink-0 overflow-hidden shadow-[10px_0_50px_rgba(0,0,0,0.1)]">

          <img src="<%= salon.image_url %>" class="absolute inset-0 w-full h-full object-cover z-0"
            alt="<%= salon.name %>">

          <div class="absolute inset-0 bg-[#0F172A]/85 z-10"></div>

          <div class="relative z-20">
            <span
              class="inline-block px-4 py-1.5 bg-[#E2B171] text-white text-[10px] font-black uppercase tracking-[0.5em] rounded mb-10">
              GLOBAL ENTERPRISE PARTNER
            </span>

            <h1 class="text-7xl md:text-8xl lg:text-[7vw] font-black text-white tracking-tighter leading-[0.85] mb-12">
              <%= salon.name %>
            </h1>

            <div class="space-y-12">
              <div class="flex items-start gap-8">
                <div
                  class="w-16 h-16 rounded-3xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
                  <i class="fa-solid fa-location-dot text-2xl text-[#E2B171]"></i>
                </div>
                <div class="min-w-0">
                  <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-2">Primary Headquarters
                  </p>
                  <p class="text-white text-2xl font-bold truncate">
                    <%= salon.location %>
                  </p>

        
                  <p class="text-slate-300 text-base mt-2 leading-relaxed max-w-sm">
                    <%= salon.address %>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-8">
                <div
                  class="w-16 h-16 rounded-3xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
                  <i class="fa-solid fa-phone text-2xl text-[#E2B171]"></i>
                </div>
                <div>
                  <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-2">Direct Operations
                    Line</p>
                  <p class="text-white text-2xl font-bold">
                    <%= salon.phone %>
                  </p>
                  <p class="text-slate-300 text-sm mt-1 uppercase tracking-widest">
                    <%= salon.email %>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="relative z-20 pt-10 border-t border-white/20">
            <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.5em]">COMMAND CENTER &copy; 2025</p>
          </div>
        </aside>

        <main class="w-full lg:w-[60vw] min-h-screen bg-white flex flex-col shrink-0">
          <div class="flex-1 overflow-y-auto p-8 md:p-12 lg:p-20 custom-scroll">
            <div class="flex items-end justify-between mb-8">
              <div>
                <h2 class="text-6xl lg:text-7xl font-black text-[#0F172A] tracking-tighter leading-none">Appointment
                  Ledger</h2>
                <p class="text-slate-400 text-xs font-black uppercase tracking-[0.4em] mt-3">Manage active bookings and
                  view history</p>
              </div>
              <div class="flex items-center gap-3">
                <div class="bg-white rounded-full shadow px-1 py-1 flex items-center">
                  <button id="tab-ledger" onclick="showTab('ledger')"
                    class="px-6 py-3 text-sm font-black uppercase tracking-widest text-[#0F172A] rounded-full">Ledger</button>
                  <button id="tab-history" onclick="showTab('history')"
                    class="px-6 py-3 text-sm font-black uppercase tracking-widest text-slate-400 rounded-full">History</button>
                </div>
                    <button
                      class="px-6 py-3 bg-[#0F172A] text-white font-black rounded-2xl hover:bg-[#E2B171] transition-all text-xs uppercase tracking-widest shadow-2xl">Export
                      .CSV</button>
              </div>
            </div>

            <!-- LEDGER TABLE: show active bookings (not completed) -->
            <div id="ledgerTab">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b-4 border-[#0F172A]">
                    <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Order Profile</th>
                    <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Schedule</th>
                    <th class="pb-6 text-right text-xs font-black uppercase tracking-[0.5em] text-slate-400">Manage
                      Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y-2 divide-slate-100">
                  <% const activeBookings=(bookings || []).filter(b=> b.status !== 'completed'); %>
                    <% if (activeBookings.length> 0) { %>
                      <% activeBookings.forEach(booking=> { %>
                        <tr class="group hover:bg-[#F8FAFC] transition-all">
                          <td class="py-12">
                            <span
                              class="text-4xl font-black text-[#0F172A] group-hover:text-[#E2B171] transition-colors leading-none block mb-2">
                              <%= booking.feature_name %>
                            </span>
                            <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">ID: #ORD-<%=
                                booking.id %></span>
                          </td>
                          <td class="py-12">
                            <span class="text-2xl font-black text-[#0F172A] block">
                              <%= booking.dayslot %>
                            </span>
                            <span class="text-base font-bold text-slate-400 uppercase tracking-tighter">
                              <%= booking.timeslot %>
                            </span>
                          </td>
                          <td class="py-12 text-right">
                            <select onchange="updateStatus(<%= booking.id %>, this.value)"
                              class="px-6 py-3 rounded-full text-[11px] font-black uppercase tracking-[0.2em] shadow-lg border-2 outline-none transition-all cursor-pointer <%= booking.status === 'scheduled' ? 'bg-blue-50 text-blue-600 border-blue-100' : booking.status === 'ongoing' ? 'bg-amber-50 text-amber-600 border-amber-100' : 'bg-green-50 text-green-600 border-green-100' %>">
                              <option value="scheduled" <%=booking.status==='scheduled' ? 'selected' : '' %>>Scheduled
                              </option>
                              <option value="ongoing" <%=booking.status==='ongoing' ? 'selected' : '' %>>Ongoing
                              </option>
                              <option value="completed" <%=booking.status==='completed' ? 'selected' : '' %>>Completed
                              </option>
                            </select>
                          </td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="3" class="py-40 text-center">
                                <p class="text-slate-400 font-bold uppercase tracking-[0.4em] text-lg">No active
                                  bookings</p>
                              </td>
                            </tr>
                            <% } %>
                </tbody>
              </table>
            </div>

            <!-- HISTORY TABLE: show completed bookings -->
            <div id="historyTab" class="hidden">
              <div class="mb-6">
                <h3 class="text-2xl font-extrabold text-[#0F172A]">Completed Bookings</h3>
                <p class="text-slate-400 text-sm mt-2">All features that have been marked as completed are stored here.
                </p>
              </div>

              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b-4 border-[#0F172A]">
                    <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Feature</th>
                    <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Completed On</th>
                    <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Notes</th>
                  </tr>
                </thead>
                <tbody class="divide-y-2 divide-slate-100">
                  <% const completed=(bookings || []).filter(b=> b.status === 'completed'); %>
                    <% if (completed.length> 0) { %>
                      <% completed.forEach(entry=> { %>
                        <tr class="group hover:bg-[#F8FAFC] transition-all">
                          <td class="py-6">
                            <span class="text-xl font-bold text-[#0F172A]">
                              <%= entry.feature_name %>
                            </span>
                            <div class="text-xs text-slate-400 uppercase tracking-widest mt-2">Order ID: #ORD-<%=
                                entry.id %>
                            </div>
                          </td>
                          <td class="py-6">
                            <span class="text-sm text-[#0F172A] font-semibold">
                              <%= entry.dayslot %>
                            </span>
                            <div class="text-xs text-slate-400 mt-1">
                              <%= entry.timeslot %>
                            </div>
                          </td>
                          <td class="py-6">
                            <p class="text-sm text-slate-600">
                              <%= entry.notes || '-' %>
                            </p>
                          </td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="3" class="py-40 text-center">
                                <p class="text-slate-400 font-bold uppercase tracking-[0.4em] text-lg">No completed
                                  bookings yet</p>
                              </td>
                            </tr>
                            <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </main>

        <% } %>

</div>

<!-- Improved footer -->
<footer class="bg-gradient-to-t from-slate-900 via-slate-900/90 to-transparent text-white mt-12">
  <div class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <h2 class="text-2xl font-extrabold tracking-tight">SALSO<span class="text-[#E2B171]">.</span></h2>
      <p class="text-slate-300 mt-3">Premium salon network connecting artisans with clients. Built for quality and reliability.</p>
      <div class="flex items-center gap-3 mt-4 text-slate-400 text-sm">
        <i class="fa-solid fa-phone"></i>
        <span><%= salon ? salon.phone : '—' %></span>
      </div>
    </div>

    <div class="flex flex-col">
      <h3 class="text-sm font-black uppercase text-slate-400 mb-4">Quick Links</h3>
      <a href="/" class="text-white hover:text-[#E2B171] mb-2">Home</a>
      <a href="/salons" class="text-white hover:text-[#E2B171] mb-2">Salons</a>
      <a href="/contact" class="text-white hover:text-[#E2B171] mb-2">Contact</a>
    </div>

    <div>
      <h3 class="text-sm font-black uppercase text-slate-400 mb-4">Stay Connected</h3>
      <p class="text-slate-300 mb-4 text-sm">Follow us for updates and offers.</p>
      <div class="flex items-center gap-3">
        <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20"><i class="fa-brands fa-instagram text-white"></i></a>
        <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20"><i class="fa-brands fa-facebook text-white"></i></a>
        <a href="#" class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20"><i class="fa-brands fa-twitter text-white"></i></a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 mt-4">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center text-sm text-slate-400">
