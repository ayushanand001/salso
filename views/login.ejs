<%- include("partials/header") %>

  <h2 class="text-xl font-semibold text-center mb-4">Login</h2>

  <% if (typeof error !=="undefined" ) { %>
    <p class="text-red-500 text-center mb-3">
      <%= error %>
    </p>
    <% } %>

      <form action="/login" method="POST" class="space-y-3">
        <input type="email" name="email" placeholder="Email" class="w-full border p-2 rounded" required>

        <input type="password" name="password" placeholder="Password" class="w-full border p-2 rounded" required>

        <button type="submit" class="w-full bg-green-600 text-white p-2 rounded hover:bg-green-700">
          Login
        </button>
      </form>

      <%- include("partials/footer") %>