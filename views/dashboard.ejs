<%- include("partials/header") %>

<div class="space-y-8 pb-12">
  <div class="text-center mb-10">
    <h2 class="text-3xl font-extrabold tracking-tighter text-[#0F172A] mb-2">User Dashboard</h2>
    <p class="text-slate-400 text-xs font-bold uppercase tracking-widest">SALSO Premium</p>
  </div>

  <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-xl">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="text-sm text-slate-400 font-bold uppercase tracking-widest mb-2">Welcome back,</p>
        <h3 class="text-3xl font-extrabold tracking-tighter text-[#0F172A]"><%= user.name %></h3>
      </div>
      <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center">
        <i class="fa-solid fa-user text-2xl text-[#E2B171]"></i>
      </div>
    </div>
    
    <div class="pt-6 border-t border-slate-100">
      <div class="flex items-center space-x-3">
        <span class="text-sm font-bold text-slate-400 uppercase tracking-widest">Role:</span>
        <span class="px-4 py-2 bg-[#0F172A] text-[#E2B171] text-xs font-extrabold rounded-full uppercase tracking-widest">
          <%= user.role %>
        </span>
      </div>
    </div>
  </div>

  <% if (user.role === "admin") { %>
    <a href="/admin"
       class="block text-center bg-[#0F172A] text-white font-extrabold py-4 px-6 rounded-2xl hover:bg-[#E2B171] shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 uppercase text-xs tracking-widest">
       <span class="flex items-center justify-center space-x-2">
         <i class="fa-solid fa-crown"></i>
         <span>Go to Admin Panel</span>
       </span>
    </a>
  <% } %>

  <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all">
      <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-4">
        <i class="fa-solid fa-chart-line text-xl text-[#E2B171]"></i>
      </div>
      <h4 class="font-extrabold text-[#0F172A] mb-2">Statistics</h4>
      <p class="text-sm text-slate-400 font-medium">View your account stats</p>
    </div>
    <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-lg hover:shadow-xl hover:border-[#E2B171] transition-all">
      <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center mb-4">
        <i class="fa-solid fa-gear text-xl text-[#E2B171]"></i>
      </div>
      <h4 class="font-extrabold text-[#0F172A] mb-2">Settings</h4>
      <p class="text-sm text-slate-400 font-medium">Manage your preferences</p>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
