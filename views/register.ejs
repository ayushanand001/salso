<%- include("partials/header") %>

  <div class="text-center mb-8">
    <h2 class="text-3xl font-extrabold tracking-tighter text-[#0F172A] mb-2">Create Account</h2>
    <p class="text-slate-400 font-medium">Join SALSO today and get started</p>
  </div>

  <% if (typeof error !=="undefined" ) { %>
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
      <div class="flex items-center">
        <i class="fa-solid fa-circle-exclamation text-red-500 mr-2"></i>
        <span class="text-red-600 text-sm font-bold">
          <%= error %>
        </span>
      </div>
    </div>
    <% } %>

      <form action="/register" method="POST" class="space-y-6">
        <div>
          <label class="block text-sm font-bold text-[#0F172A] mb-2">Full Name</label>
          <input type="text" name="name" placeholder="Enter your full name"
            class="w-full px-4 py-4 border border-slate-100 rounded-2xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-[#E2B171] focus:border-[#E2B171] transition-all duration-200 font-medium"
            required>
        </div>

        <div>
          <label class="block text-sm font-bold text-[#0F172A] mb-2">Email Address</label>
          <input type="email" name="email" placeholder="Enter your email"
            class="w-full px-4 py-4 border border-slate-100 rounded-2xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-[#E2B171] focus:border-[#E2B171] transition-all duration-200 font-medium"
            required>
        </div>

        <div>
          <label class="block text-sm font-bold text-[#0F172A] mb-2">Password</label>
          <input type="password" name="password" placeholder="Create a strong password"
            class="w-full px-4 py-4 border border-slate-100 rounded-2xl bg-slate-50 focus:outline-none focus:ring-2 focus:ring-[#E2B171] focus:border-[#E2B171] transition-all duration-200 font-medium"
            required>
        </div>

        <button type="submit"
          class="w-full bg-[#0F172A] text-white font-extrabold py-4 rounded-2xl hover:bg-[#E2B171] shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 uppercase text-xs tracking-widest">
          Create Account
        </button>
      </form>

      <div class="mt-8 text-center">
        <p class="text-sm text-slate-400 font-medium">
          Already have an account?
          <a href="/login" class="text-[#E2B171] hover:text-[#B88A44] font-extrabold hover:underline transition-colors">
            Sign in here
          </a>
        </p>
      </div>

      <%- include("partials/footer") %>