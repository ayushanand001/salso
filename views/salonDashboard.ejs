<%- include("partials/header") %>

<div class="fixed inset-0 w-screen h-screen bg-white z-[9999] flex flex-col lg:flex-row overflow-hidden font-['Plus_Jakarta_Sans',sans-serif]">

  <% if (!salon) { %>
    <div class="w-full h-full flex items-center justify-center bg-slate-50">
      <h2 class="text-5xl font-black text-slate-200 uppercase tracking-[1em]">System Offline</h2>
    </div>
  <% } else { %>

    <aside class="w-full lg:w-[40vw] h-full relative p-12 lg:p-20 flex flex-col justify-between shrink-0 overflow-hidden shadow-[10px_0_50px_rgba(0,0,0,0.1)]">
      
      <img src="<%= salon.image_url %>" class="absolute inset-0 w-full h-full object-cover z-0" alt="<%= salon.name %>">
      
      <div class="absolute inset-0 bg-[#0F172A]/85 z-10"></div>

      <div class="relative z-20">
        <span class="inline-block px-4 py-1.5 bg-[#E2B171] text-white text-[10px] font-black uppercase tracking-[0.5em] rounded mb-10">
          GLOBAL ENTERPRISE PARTNER
        </span>
        
        <h1 class="text-7xl md:text-8xl lg:text-[7vw] font-black text-white tracking-tighter leading-[0.85] mb-12">
          <%= salon.name %>
        </h1>

        <div class="space-y-12">
          <div class="flex items-start gap-8">
            <div class="w-16 h-16 rounded-3xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
              <i class="fa-solid fa-location-dot text-2xl text-[#E2B171]"></i>
            </div>
            <div class="min-w-0">
              <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-2">Primary Headquarters</p>
              <p class="text-white text-2xl font-bold truncate"><%= salon.location %></p>
              <p class="text-slate-300 text-base mt-2 leading-relaxed max-w-sm"><%= salon.address %></p>
            </div>
          </div>

          <div class="flex items-start gap-8">
            <div class="w-16 h-16 rounded-3xl bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-white/20">
              <i class="fa-solid fa-phone text-2xl text-[#E2B171]"></i>
            </div>
            <div>
              <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.3em] mb-2">Direct Operations Line</p>
              <p class="text-white text-2xl font-bold"><%= salon.phone %></p>
              <p class="text-slate-300 text-sm mt-1 uppercase tracking-widest"><%= salon.email %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative z-20 pt-10 border-t border-white/20">
        <p class="text-slate-400 text-[10px] font-black uppercase tracking-[0.5em]">COMMAND CENTER &copy; 2025</p>
      </div>
    </aside>

    <main class="w-full lg:w-[60vw] h-full bg-white flex flex-col shrink-0">
      <div class="flex-1 overflow-y-auto p-12 lg:p-20 custom-scroll">
        <div class="flex items-end justify-between mb-8">
          <div>
            <h2 class="text-6xl lg:text-7xl font-black text-[#0F172A] tracking-tighter leading-none">Appointment Ledger</h2>
            <p class="text-slate-400 text-xs font-black uppercase tracking-[0.4em] mt-3">Manage active bookings and view history</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="bg-white rounded-full shadow px-1 py-1 flex items-center">
              <button id="tab-ledger" onclick="showTab('ledger')" class="px-6 py-3 text-sm font-black uppercase tracking-widest text-[#0F172A] rounded-full">Ledger</button>
              <button id="tab-history" onclick="showTab('history')" class="px-6 py-3 text-sm font-black uppercase tracking-widest text-slate-400 rounded-full">History</button>
            </div>
            <button class="px-6 py-3 bg-[#0F172A] text-white font-black rounded-2xl hover:bg-[#E2B171] transition-all text-xs uppercase tracking-widest shadow-2xl">Export .CSV</button>
          </div>
        </div>

        <!-- LEDGER TABLE: show active bookings (not completed) -->
        <div id="ledgerTab">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b-4 border-[#0F172A]">
                <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Order Profile</th>
                <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Schedule</th>
                <th class="pb-6 text-right text-xs font-black uppercase tracking-[0.5em] text-slate-400">Manage Status</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-slate-100">
              <% const activeBookings = (bookings || []).filter(b => b.status !== 'completed'); %>
              <% if (activeBookings.length > 0) { %>
                <% activeBookings.forEach(booking => { %>
                  <tr class="group hover:bg-[#F8FAFC] transition-all">
                    <td class="py-12">
                      <span class="text-4xl font-black text-[#0F172A] group-hover:text-[#E2B171] transition-colors leading-none block mb-2"><%= booking.feature_name %></span>
                      <span class="text-xs font-bold text-slate-300 uppercase tracking-widest">ID: #ORD-<%= booking.id %></span>
                    </td>
                    <td class="py-12">
                      <span class="text-2xl font-black text-[#0F172A] block"><%= booking.dayslot %></span>
                      <span class="text-base font-bold text-slate-400 uppercase tracking-tighter"><%= booking.timeslot %></span>
                    </td>
                    <td class="py-12 text-right">
                      <select onchange="updateStatus(<%= booking.id %>, this.value)" class="px-6 py-3 rounded-full text-[11px] font-black uppercase tracking-[0.2em] shadow-lg border-2 outline-none transition-all cursor-pointer <%= booking.status === 'scheduled' ? 'bg-blue-50 text-blue-600 border-blue-100' : booking.status === 'ongoing' ? 'bg-amber-50 text-amber-600 border-amber-100' : 'bg-green-50 text-green-600 border-green-100' %>">
                        <option value="scheduled" <%= booking.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                        <option value="ongoing" <%= booking.status === 'ongoing' ? 'selected' : '' %>>Ongoing</option>
                        <option value="completed" <%= booking.status === 'completed' ? 'selected' : '' %>>Completed</option>
                      </select>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="py-40 text-center">
                    <p class="text-slate-400 font-bold uppercase tracking-[0.4em] text-lg">No active bookings</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- HISTORY TABLE: show completed bookings -->
        <div id="historyTab" class="hidden">
          <div class="mb-6">
            <h3 class="text-2xl font-extrabold text-[#0F172A]">Completed Bookings</h3>
            <p class="text-slate-400 text-sm mt-2">All features that have been marked as completed are stored here.</p>
          </div>

          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b-4 border-[#0F172A]">
                <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Feature</th>
                <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Completed On</th>
                <th class="pb-6 text-xs font-black uppercase tracking-[0.5em] text-slate-400">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-slate-100">
              <% const completed = (bookings || []).filter(b => b.status === 'completed'); %>
              <% if (completed.length > 0) { %>
                <% completed.forEach(entry => { %>
                  <tr class="group hover:bg-[#F8FAFC] transition-all">
                    <td class="py-6">
                      <span class="text-xl font-bold text-[#0F172A]"><%= entry.feature_name %></span>
                      <div class="text-xs text-slate-400 uppercase tracking-widest mt-2">Order ID: #ORD-<%= entry.id %></div>
                    </td>
                    <td class="py-6">
                      <span class="text-sm text-[#0F172A] font-semibold"><%= entry.dayslot %></span>
                      <div class="text-xs text-slate-400 mt-1"><%= entry.timeslot %></div>
                    </td>
                    <td class="py-6">
                      <p class="text-sm text-slate-600"><%= entry.notes || '-' %></p>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="3" class="py-40 text-center">
                    <p class="text-slate-400 font-bold uppercase tracking-[0.4em] text-lg">No completed bookings yet</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

  <% } %>

</div>

<script>
  // Script to update database via AJAX
  async function updateStatus(bookingId, newStatus) {
    try {
      const response = await fetch('/bookings/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: bookingId, status: newStatus })
      });

      if (response.ok) {
        // Refresh to update badge colors or handle UI via state
        // If moved to completed, switch to History tab automatically
        if (newStatus === 'completed') {
          showTab('history');
        } else {
          // reload to reflect status change
          window.location.reload();
        }
      } else {
        alert("Update failed. Please check network connection.");
      }
    } catch (err) {
      console.error("Error updating status:", err);
    }
  }

  // Tab switcher
  function showTab(name) {
    const ledger = document.getElementById('ledgerTab');
    const history = document.getElementById('historyTab');
    const tabLedger = document.getElementById('tab-ledger');
    const tabHistory = document.getElementById('tab-history');
    if (name === 'history') {
      ledger.classList.add('hidden');
      history.classList.remove('hidden');
      tabLedger.classList.remove('text-[#0F172A]');
      tabLedger.classList.add('text-slate-400');
      tabHistory.classList.remove('text-slate-400');
      tabHistory.classList.add('text-[#0F172A]');
    } else {
      history.classList.add('hidden');
      ledger.classList.remove('hidden');
      tabHistory.classList.remove('text-[#0F172A]');
      tabHistory.classList.add('text-slate-400');
      tabLedger.classList.remove('text-slate-400');
      tabLedger.classList.add('text-[#0F172A]');
    }
  }

  // Default to ledger
  document.addEventListener('DOMContentLoaded', function() { showTab('ledger'); });
</script>

<style>
  body { overflow: hidden !important; }
  .custom-scroll::-webkit-scrollbar { width: 8px; }
  .custom-scroll::-webkit-scrollbar-track { background: #fff; }
  .custom-scroll::-webkit-scrollbar-thumb { background: #f1f5f9; border-radius: 0; }
  .custom-scroll::-webkit-scrollbar-thumb:hover { background: #E2B171; }
</style>

<%- include("partials/footer") %>