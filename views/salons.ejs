<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Salso Premium | Luxury Grooming</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      letter-spacing: -0.01em;
    }

    .luxury-card {
      background: white;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid #f1f5f9;
    }

    .luxury-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
      border-color: #E2B171;
    }

    .gold-gradient {
      background: linear-gradient(135deg, #E2B171 0%, #B88A44 100%);
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .no-scrollbar {
      scrollbar-width: none;
    }
  </style>
</head>

<body class="bg-[#FBFCFE] text-[#0F172A] pb-24 md:pb-0">

  <!-- HEADER -->
  <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 flex justify-between items-center">

      <h1 class="text-2xl font-extrabold tracking-tighter">
        SALSO<span class="text-[#E2B171]">.</span>
      </h1>

      <!-- Desktop Search -->
      <div class="hidden md:flex relative w-1/3">
        <input id="searchInput" type="text" placeholder="Search luxury salons..."
          class="w-full h-11 bg-slate-50 border border-slate-100 rounded-full pl-12 pr-4 text-sm focus:ring-2 focus:ring-[#E2B171] outline-none">
        <i class="fa-solid fa-magnifying-glass absolute left-5 top-1/2 -translate-y-1/2 text-slate-300"></i>
      </div>

      <form action="/logout" method="POST">
        <button
          class="w-10 h-10 rounded-xl bg-[#0F172A] text-white flex items-center justify-center hover:bg-[#E2B171] transition-all">
          <i class="fa-solid fa-crown"></i>
        </button>
      </form>
    </div>

    <!-- Mobile Search -->
    <div class="px-5 pb-4 md:hidden">
      <input id="searchInputMobile" type="text" placeholder="Search salons..."
        class="w-full h-12 bg-slate-100 rounded-xl pl-12 pr-4 text-sm focus:ring-2 focus:ring-[#E2B171] outline-none">
    </div>
  </header>

  <!-- MAIN -->
  <main class="max-w-7xl mx-auto px-4 md:px-8 mt-10">

    <h2 class="text-3xl font-extrabold tracking-tighter mb-8">
      Curated Luxury Salons
    </h2>

    <!-- SALON GRID -->
    <div id="salonContainer"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

      <% salons.forEach(salon => { %>
        <div class="luxury-card group rounded-[2rem] overflow-hidden flex flex-col h-full">

          <div class="relative h-60 overflow-hidden">
            <img src="<%= salon.image_url || 'https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=800' %>"
              class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700">
          </div>

          <div class="p-7 flex flex-col flex-grow">
            <h3 class="font-extrabold text-lg group-hover:text-[#E2B171]">
              <%= salon.name %>
            </h3>

            <p class="text-slate-400 text-[11px] font-bold uppercase tracking-widest mt-1">
              <%= salon.location %>
            </p>

            <div class="mt-auto flex justify-between items-center border-t border-slate-50 pt-6">
              <span class="text-xl font-extrabold">
                ₹<%= Math.floor(Math.random() * 500) + 500 %>
              </span>

              <a href="/salons/<%= salon.id %>">
                <button
                  class="bg-[#0F172A] text-white px-6 py-3 rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#E2B171] transition">
                  Book
                </button>
              </a>
            </div>
          </div>
        </div>
      <% }) %>

    </div>
  </main>

  <!-- LIVE SEARCH SCRIPT -->
  <script>
    const desktopSearch = document.getElementById("searchInput");
    const mobileSearch = document.getElementById("searchInputMobile");
    const salonContainer = document.getElementById("salonContainer");
    let debounceTimer;
    
    // Store original HTML to restore when search is cleared
    const originalSalonsHTML = salonContainer.innerHTML;

    function renderSalon(salon) {
      return `
        <div class="luxury-card group rounded-[2rem] overflow-hidden flex flex-col h-full">
          <div class="relative h-60 overflow-hidden">
            <img src="${salon.image_url || 'https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=800'}"
              class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700">
          </div>
          <div class="p-7 flex flex-col flex-grow">
            <h3 class="font-extrabold text-lg group-hover:text-[#E2B171]">${salon.name}</h3>
            <p class="text-slate-400 text-[11px] font-bold uppercase tracking-widest mt-1">${salon.location}</p>
            <div class="mt-auto flex justify-between items-center border-t border-slate-50 pt-6">
              <span class="text-xl font-extrabold">₹${Math.floor(Math.random() * 500) + 500}</span>
              <a href="/salons/${salon.id}">
                <button class="bg-[#0F172A] text-white px-6 py-3 rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-[#E2B171] transition">
                  Book
                </button>
              </a>
            </div>
          </div>
        </div>
      `;
    }

    function handleSearch(searchInput) {
      if (!searchInput) return;

      searchInput.addEventListener("input", () => {
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(async () => {
          const query = searchInput.value.trim();

          // If search is empty, restore original salons
          if (!query) {
            salonContainer.innerHTML = originalSalonsHTML;
            return;
          }

          try {
            const res = await fetch(`/api/salons/search?search=${encodeURIComponent(query)}`);
            
            if (!res.ok) {
              throw new Error('Search failed');
            }
            
            const salons = await res.json();
            salonContainer.innerHTML = "";

            if (salons.length === 0) {
              salonContainer.innerHTML =
                "<p class='col-span-full text-center text-slate-400 font-bold mt-8'>No salons found</p>";
              return;
            }

            salons.forEach(salon => {
              salonContainer.innerHTML += renderSalon(salon);
            });
          } catch (error) {
            console.error('Search error:', error);
            salonContainer.innerHTML =
              "<p class='col-span-full text-center text-red-400 font-bold mt-8'>Error searching salons. Please try again.</p>";
          }
        }, 300);
      });
    }

    handleSearch(desktopSearch);
    handleSearch(mobileSearch);
  </script>

</body>
</html>
