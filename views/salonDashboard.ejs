      <div class="flex items-center gap-4 mt-3 md:mt-0">
        <a href="#" class="hover:text-white">Privacy</a>
        <a href="#" class="hover:text-white">Terms</a>
      </div>
    </div>
  </div>
</footer>

  <script>
    // Script to update database via AJAX
    async function updateStatus(bookingId, newStatus) {
      try {
        const response = await fetch('/bookings/update-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: bookingId, status: newStatus })
        });

        if (response.ok) {
          // Refresh to update badge colors or handle UI via state
          // If moved to completed, switch to History tab automatically
          if (newStatus === 'completed') {
            showTab('history');
          } else {
            // reload to reflect status change
            window.location.reload();
          }
        } else {
          alert("Update failed. Please check network connection.");
        }
      } catch (err) {
        console.error("Error updating status:", err);
      }
    }

    // Tab switcher
    function showTab(name) {
      const ledger = document.getElementById('ledgerTab');
      const history = document.getElementById('historyTab');
      const tabLedger = document.getElementById('tab-ledger');
      const tabHistory = document.getElementById('tab-history');
      if (name === 'history') {
        ledger.classList.add('hidden');
        history.classList.remove('hidden');
        tabLedger.classList.remove('text-[#0F172A]');
        tabLedger.classList.add('text-slate-400');
        tabHistory.classList.remove('text-slate-400');
        tabHistory.classList.add('text-[#0F172A]');
      } else {
        history.classList.add('hidden');
        ledger.classList.remove('hidden');
        tabHistory.classList.remove('text-[#0F172A]');
        tabHistory.classList.add('text-slate-400');
        tabLedger.classList.remove('text-slate-400');
        tabLedger.classList.add('text-[#0F172A]');
      }
    }

    // Default to ledger
    document.addEventListener('DOMContentLoaded', function () { showTab('ledger'); });

    // Salon profile dropdown toggle
    function toggleSalonProfile() {
      const dd = document.getElementById('salonProfileDropdown');
      if (!dd) return;
      dd.classList.toggle('hidden');
    }

    // Click outside to close
    document.addEventListener('click', function (e) {
      const btn = document.getElementById('salonProfileBtn');
      const dd = document.getElementById('salonProfileDropdown');
      if (!btn || !dd) return;
      if (!btn.contains(e.target) && !dd.contains(e.target)) {
        dd.classList.add('hidden');
      }
    });
  </script>

  <style>
    body {
      overflow: auto;
    }

    .custom-scroll::-webkit-scrollbar {
      width: 8px;
    }

    .custom-scroll::-webkit-scrollbar-track {
      background: #fff;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
      background: #f1f5f9;
      border-radius: 0;
    }

    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #E2B171;
    }
  </style>

  