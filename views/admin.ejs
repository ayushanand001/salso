<%- include("partials/header") %>

<div class="space-y-6">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-2">Admin Panel</h2>
    <div class="w-16 h-1 bg-gradient-to-r from-purple-500 to-pink-500 mx-auto rounded-full"></div>
  </div>

  <div class="bg-gradient-to-br from-purple-50 via-pink-50 to-red-50 rounded-xl p-8 border border-purple-200 shadow-xl">
    <div class="flex items-start space-x-4">
      <div class="bg-gradient-to-br from-purple-500 to-pink-500 rounded-full p-4 shadow-lg">
        <span class="text-3xl">🛡️</span>
      </div>
      <div class="flex-1">
        <h3 class="text-xl font-bold text-gray-800 mb-3">Administrative Access</h3>
        <p class="text-gray-700 leading-relaxed">
          Only users with <strong class="text-purple-600">admin</strong> role can access this page.
        </p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-md hover:shadow-lg transition-all">
      <div class="text-3xl mb-3">👥</div>
      <h4 class="font-semibold text-gray-800 mb-2">User Management</h4>
      <p class="text-sm text-gray-500">Manage users and permissions</p>
    </div>
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-md hover:shadow-lg transition-all">
      <div class="text-3xl mb-3">📈</div>
      <h4 class="font-semibold text-gray-800 mb-2">Analytics</h4>
      <p class="text-sm text-gray-500">View system statistics</p>
    </div>
    <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-md hover:shadow-lg transition-all">
      <div class="text-3xl mb-3">🔧</div>
      <h4 class="font-semibold text-gray-800 mb-2">Configuration</h4>
      <p class="text-sm text-gray-500">System settings and options</p>
    </div>
  </div>

  <div class="mt-8 bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg">
    <div class="flex items-center">
      <span class="text-blue-800 text-sm">
        <strong>Note:</strong> You have full administrative privileges on this system.
      </span>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
